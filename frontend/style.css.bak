/* ============================================================
   SkyTrip — Weather-Based Travel Recommendation
   Modern travel/weather design. Fully responsive.
   ============================================================ */

:root {
  --primary: #0f4c5c;
  --primary-dark: #0a3a46;
  --primary-light: #e6f2f5;
  --accent: #f4a261;
  --accent-dark: #e76f51;
  --ink: #173042;
  --muted: #5b7282;
  --bg: #f4f7fa;
  --card-bg: #ffffff;
  --radius-lg: 22px;
  --radius-md: 14px;
  --radius-sm: 10px;
  --shadow-sm: 0 4px 14px rgba(15, 76, 92, 0.08);
  --shadow-md: 0 12px 32px rgba(15, 76, 92, 0.14);
  --shadow-lg: 0 24px 60px rgba(15, 76, 92, 0.22);
  --score-good: #2ea44f;
  --score-mid: #d98324;
  --score-bad: #c0392b;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; }

body {
  font-family: 'Plus Jakarta Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
  color: var(--ink);
  background: var(--bg);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

img { max-width: 100%; display: block; }
button { font-family: inherit; cursor: pointer; }
input { font-family: inherit; }

.container { width: min(1200px, 92%); margin-inline: auto; }

/* ============ Header ============ */
.site-header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(14px);
  border-bottom: 1px solid rgba(15, 76, 92, 0.08);
}

.nav { display: flex; align-items: center; justify-content: space-between; padding: 16px 24px; }
.brand { display: flex; align-items: center; gap: 12px; text-decoration: none; color: var(--ink); }
.brand-mark { font-size: 28px; }
.brand-name { font-size: 24px; font-weight: 800; letter-spacing: -0.5px; }
.brand-name span { color: var(--accent-dark); }

.nav-links { display: flex; gap: 32px; list-style: none; }
.nav-links a { color: var(--muted); text-decoration: none; font-weight: 600; font-size: 15px; transition: color 0.2s; position: relative; }
.nav-links a:hover { color: var(--primary); }
.nav-links a::after {
  content: ''; position: absolute; bottom: -4px; left: 0; width: 0; height: 2px;
  background: var(--primary); transition: width 0.3s;
}
.nav-links a:hover::after { width: 100%; }

/* Mobile menu button */
.mobile-menu-btn { display: none; padding: 8px; background: none; border: none; cursor: pointer; }
.mobile-menu-btn span { display: block; width: 25px; height: 3px; background: var(--primary); margin: 5px 0; transition: transform 0.3s; }
.mobile-menu-btn.active span:nth-child(2) { opacity: 0; }
.mobile-menu-btn.active span:nth-child(1) { transform: rotate(45deg) translate(5px, 5px); }
.mobile-menu-btn.active span:nth-child(3) { transform: rotate(-45deg) translate(7px, -6px); }

@media (max-width: 768px) {
  .nav-links { position: fixed; top: 0; right: 0; height: 100vh; width: 280px; background: #fff; flex-direction: column; padding-top: 80px; box-shadow: -4px 0 12px rgba(0,0,0,0.1); z-index: 100; transform: translateX(100%); transition: transform 0.3s; }
  .nav-links.active { transform: translateX(0); }
  .nav-links li { width: 100%; border-bottom: 1px solid rgba(0,0,0,0.05); }
  .nav-links a { width: 100%; padding: 12px 20px; font-size: 18px; }
  .mobile-menu-btn { display: block; }
}

/* ============ Hero ============ */
.hero { position: relative; overflow: hidden; padding: 110px 0 90px; text-align: center; }

.hero-bg {
  position: absolute; inset: 0; z-index: -1;
  background:
    radial-gradient(1000px 500px at 15% 0%, rgba(244, 162, 97, 0.35), transparent 60%),
    radial-gradient(900px 500px at 85% 20%, rgba(15, 76, 92, 0.22), transparent 60%),
    linear-gradient(160deg, #eef7fa 0%, #ffffff 55%, #e9f3f6 100%);
}

.hero-eyebrow {
  display: inline-block; color: var(--accent-dark); font-weight: 700;
  font-size: 14px; letter-spacing: 2px; text-transform: uppercase;
  background: rgba(244, 162, 97, 0.14); padding: 8px 20px; border-radius: 999px; margin-bottom: 24px;
}

.hero-title { font-size: clamp(38px, 7vw, 64px); font-weight: 800; letter-spacing: -2px; line-height: 1.2; margin-bottom: 20px; }
.hero-title span { color: var(--primary); position: relative; }
.hero-title span::after {
  content: ''; position: absolute; left: 0; right: 0; bottom: 6px; height: 16px;
  background: rgba(244, 162, 97, 0.5); z-index: -1; border-radius: 6px;
}

.hero-sub { max-width: 720px; margin: 0 auto 36px; color: var(--muted); font-size: 18px; line-height: 1.7; }

/* Search panel */
.search-panel {
  display: flex; gap: 18px; align-items: flex-end; flex-wrap: wrap; justify-content: center;
  background: #fff; border-radius: var(--radius-lg); padding: 24px;
  box-shadow: var(--shadow-md); max-width: 820px; margin: 0 auto 40px;
  border: 1px solid rgba(15, 76, 92, 0.08);
}

.search-field { display: flex; flex-direction: column; gap: 8px; text-align: left; flex: 1; min-width: 200px; }
.search-field label { font-size: 11px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.8px; }

.search-field input {
  border: 1px solid #d7e2e8; border-radius: var(--radius-sm);
  padding: 14px 18px; font-size: 16px; color: var(--ink); background: #fbfdfe;
  transition: border-color 0.2s, box-shadow 0.2s; width: 100%;
}
.search-field input:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 4px rgba(15, 76, 92, 0.12); }

.search-field input[type="date"] { padding: 14px 18px; }

.btn-search {
  display: inline-flex; align-items: center; gap: 8px;
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: #fff; border: none; border-radius: var(--radius-sm);
  padding: 13px 22px; font-size: 15px; font-weight: 700; white-space: nowrap;
  box-shadow: 0 8px 20px rgba(15, 76, 92, 0.3);
  transition: transform 0.2s, box-shadow 0.2s, filter 0.2s;
}
.btn-search:hover { transform: translateY(-2px); box-shadow: 0 12px 26px rgba(15, 76, 92, 0.38); filter: brightness(1.06); }
.btn-search:active { transform: translateY(0); }

/* ============ Filters ============ */
.filters-section { padding: 40px 0 20px; }

.filters { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; padding: 12px; background: var(--primary-light); border-radius: var(--radius-md); margin-bottom: 28px; }
.chip {
  border: 1px solid rgba(15, 76, 92, 0.3); background: #fff; color: var(--muted);
  padding: 10px 20px; border-radius: 999px; font-size: 13px; font-weight: 700;
  transition: all 0.2s; white-space: nowrap;
}
.chip:hover { border-color: var(--primary); color: var(--primary); transform: translateY(-1px); }
.chip.active { background: var(--primary); color: #fff; border-color: var(--primary); box-shadow: 0 4px 12px rgba(15, 76, 92, 0.25); }
.chip:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

@media (max-width: 480px) {
  .filters { flex-direction: column; align-items: stretch; }
  .chip { text-align: center; width: 100%; }
}

/* ============ Recommendations ============ */
.recommendations { padding: 48px 0 30px; }

.section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 26px; flex-wrap: wrap; }
.section-eyebrow { color: var(--accent-dark); font-size: 13px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; }
.section-title { font-size: clamp(24px, 4vw, 34px); font-weight: 800; letter-spacing: -0.6px; margin-top: 4px; }
.section-note { color: var(--muted); font-size: 14px; }

.status-bar { display: flex; align-items: center; gap: 12px; color: var(--muted); padding: 14px 0 20px; }
.status-bar[hidden] { display: none; }

.spinner {
  width: 22px; height: 22px; border-radius: 50%;
  border: 3px solid rgba(15, 76, 92, 0.2); border-top-color: var(--primary);
  animation: spin 0.8s linear infinite; display: inline-block;
}
@keyframes spin { to { transform: rotate(360deg); } }

.error-banner {
  background: #fdecea; color: var(--score-bad); border: 1px solid #f5c6c2;
  padding: 14px 18px; border-radius: var(--radius-md); margin-bottom: 20px; font-weight: 600;
}
.error-banner[hidden] { display: none; }

/* ============ Cards ============ */
.cards-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px;
}

.card {
  background: var(--card-bg); border-radius: var(--radius-lg); overflow: hidden;
  box-shadow: var(--shadow-sm); cursor: pointer; border: 1px solid rgba(15, 76, 92, 0.06);
  transition: transform 0.25s ease, box-shadow 0.25s ease; animation: fadeUp 0.5s ease both;
  display: flex; flex-direction: column; height: 100%;
}
.card:hover { transform: translateY(-6px); box-shadow: var(--shadow-md); }
.card:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }

.card-media {
  position: relative; height: 180px; overflow: hidden;
  background: linear-gradient(135deg, var(--grad-a, #0f4c5c), var(--grad-b, #2a9d8f));
}
.card-media::before {
  content: ''; position: absolute; inset: 0;
  background: radial-gradient(400px 180px at 70% 20%, rgba(255,255,255,0.25), transparent 60%);
}
.card-cat-emoji { font-size: 56px; filter: drop-shadow(0 6px 14px rgba(0,0,0,0.25)); transform: translateY(-4px); transition: transform 0.3s ease; }
.card:hover .card-cat-emoji { transform: translateY(-8px) scale(1.07); }

.score-badge {
  position: absolute; top: 12px; right: 12px; z-index: 2;
  background: rgba(255, 255, 255, 0.96); border-radius: 999px;
  padding: 6px 12px; font-weight: 800; font-size: 14px; color: var(--ink);
  box-shadow: var(--shadow-sm); display: flex; flex-direction: column; align-items: center; line-height: 1.15;
}
.score-badge small { font-size: 10px; font-weight: 700; color: var(--muted); letter-spacing: 0.5px; }

.score-ring { color: var(--score-good); }
.score-ring.mid { color: var(--score-mid); }
.score-ring.bad { color: var(--score-bad); }

.card-category-pill {
  position: absolute; top: 12px; left: 12px; z-index: 2;
  background: rgba(255, 255, 255, 0.92); color: var(--primary); font-size: 11px; font-weight: 800;
  letter-spacing: 0.6px; text-transform: uppercase; padding: 4px 10px; border-radius: 999px;
}

.card-body { padding: 20px 20px 24px; flex: 1; display: flex; flex-direction: column; height: 100%; }
.card-body > *:last-child { margin-bottom: 0; }

.card-title { font-size: 18px; font-weight: 800; letter-spacing: -0.3px; margin-bottom: 6px; line-height: 1.3; }
.card-title { overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }

.card-location { color: var(--muted); font-size: 12px; font-weight: 600; display: flex; align-items: center; gap: 4px; margin-top: 4px; text-transform: uppercase; letter-spacing: 0.5px; }

.card-weather { margin: 16px 0 20px; padding: 14px 18px; background: var(--primary-light); border-radius: var(--radius-md); display: flex; align-items: center; justify-content: space-between; }
.weather-emoji { font-size: 28px; }
.weather-main { flex: 1; }
.weather-main .card-temp { font-size: 20px; font-weight: 800; letter-spacing: -0.5px; margin-bottom: 2px; }
.weather-main .card-cond { font-size: 12px; color: var(--muted); font-weight: 600; text-transform: capitalize; }

.card-rain { display: flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 700; color: var(--primary-dark); }
.card-rain .rain-dot { font-size: 14px; }

.card-recommend {
  margin-top: auto; font-size: 12px; font-weight: 600; padding: 8px 14px; border-radius: var(--radius-sm);
  text-transform: uppercase; letter-spacing: 0.3px; text-align: center;
}
.reco-excellent { background: #e6f6ec; color: var(--score-good); border: 1px solid var(--score-good); }
.reco-good { background: #fdf3e3; color: var(--score-mid); border: 1px solid var(--score-mid); }
.reco-moderate { background: #fff3d9; color: #b7791f; border: 1px solid #b7791f; }
.reco-bad { background: #fdecea; color: var(--score-bad); border: 1px solid var(--score-bad); }

.card-hint { margin-top: auto; text-align: center; color: var(--muted); font-size: 11px; font-weight: 700; letter-spacing: 0.4px; text-transform: uppercase; opacity: 0; transition: opacity 0.25s; }
.card:hover .card-hint { opacity: 1; }

/* Travel Score progress ring overlay */
.score-ring-wrapper {
  position: relative; width: 32px; height: 32px; margin: 0 auto 12px;
}
.score-ring-wrapper svg {
  position: absolute; inset: 0;
}
.score-track {
  stroke: #e0e0e0; stroke-dasharray: 44; stroke-dashoffset: 44; fill: none;
}
.score-value {
  fill: none; stroke: none;
}
.score.good { stroke: var(--score-good); stroke-dashoffset: 12; }
.score.mid { stroke: var(--score-mid); stroke-dashoffset: 28; }
.score.bad { stroke: var(--score-bad); stroke-dashoffset: 40; }
.score-ring {
  position: absolute; inset: 0; border: 3px solid #e0e0e0; border-radius: 50%;
  transform: rotate(-90deg); transition: stroke-dashoffset 0.3s;
}
.score-ring.good { stroke: var(--score-good); }
.score-ring.mid { stroke: var(--score-mid); }
.score-ring.bad { stroke: var(--score-bad); }
.score-ring .score-value {
  position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
  font-size: 16px; font-weight: bold;
}

/* ============ Empty state ============ */
.empty-state { text-align: center; padding: 60px 0; color: var(--muted); font-size: 18px; }
.empty-state[hidden] { display: none; }

/* ============ How it works ============ */
.how-section { padding: 70px 0; background: linear-gradient(180deg, #fff, var(--bg)); }

.how-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 22px; margin-top: 10px; }

.how-card {
  background: #fff; border-radius: var(--radius-lg); padding: 28px 24px;
  box-shadow: var(--shadow-sm); border: 1px solid rgba(15, 76, 92, 0.06);
  transition: transform 0.25s, box-shadow 0.25s;
}
.how-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-md); }
.how-icon { font-size: 34px; display: block; margin-bottom: 12px; }
.how-card h3 { font-size: 17px; font-weight: 800; margin-bottom: 6px; }
.how-card p { color: var(--muted); font-size: 14px; }

/* ============ Footer ============ */
.site-footer { background: var(--primary-dark); color: rgba(255,255,255,0.8); padding: 34px 0; margin-top: 40px; }
.footer-inner { display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; font-size: 14px; }
.site-footer a { color: var(--accent); text-decoration: none; }
.site-footer strong { color: #fff; }

/* ============ Modal ============ */
.modal-overlay {
  position: fixed; inset: 0; z-index: 100; background: rgba(10, 42, 52, 0.6);
  backdrop-filter: blur(4px); display: flex; align-items: center; justify-content: center; padding: 20px;
  animation: fadeIn 0.2s ease;
}
.modal-overlay[hidden] { display: none; }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

.modal {
  background: #fff; border-radius: var(--radius-lg); width: min(680px, 100%);
  max-height: 90vh; overflow-y: auto; box-shadow: var(--shadow-lg);
  animation: slideUp 0.28s ease; position: relative;
}
@keyframes slideUp { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }

.modal-close {
  position: absolute; top: 14px; right: 14px; z-index: 3;
  width: 38px; height: 38px; border-radius: 50%; border: none; font-size: 22px;
  background: rgba(255, 255, 255, 0.9); color: var(--ink); box-shadow: var(--shadow-sm);
  display: flex; align-items: center; justify-content: center; line-height: 1;
  transition: background 0.2s, transform 0.2s;
}
.modal-close:hover { background: #fff; transform: scale(1.08); }

.modal-body { padding: 0; }

.modal-loading { display: flex; align-items: center; justify-content: center; gap: 12px; padding: 70px 20px; color: var(--muted); font-weight: 600; }

/* Modal content */
.modal-hero {
  position: relative; height: 210px; display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, var(--grad-a, #0f4c5c), var(--grad-b, #2a9d8f));
}
.modal-hero .card-cat-emoji { font-size: 74px; }

.modal-main { padding: 26px 30px 32px; }

.modal-title { font-size: 28px; font-weight: 800; letter-spacing: -0.6px; }
.modal-location { color: var(--muted); font-weight: 600; margin-top: 2px; }
.modal-desc { color: var(--muted); font-size: 15px; margin-top: 12px; }

.modal-badges { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 16px; }
.modal-badges .score-badge { position: static; flex-direction: row; gap: 6px; font-size: 18px; padding: 8px 16px; }
.modal-badges .score-badge small { font-size: 11px; }
.modal-badges .chip { cursor: default; }

.modal-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 22px; }

.metric {
  background: var(--bg); border: 1px solid rgba(15, 76, 92, 0.08);
  border-radius: var(--radius-md); padding: 14px 16px; display: flex; align-items: center; gap: 12px;
}
.metric-emoji { font-size: 24px; }
.metric-label { font-size: 12px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px; }
.metric-value { font-size: 17px; font-weight: 800; }

.modal-reco { margin-top: 20px; padding: 16px 18px; border-radius: var(--radius-md); font-weight: 700; font-size: 15px; }
.modal-reco strong { display: block; font-size: 17px; margin-bottom: 2px; }

.modal-activities { margin-top: 24px; }
.modal-activities h3 { font-size: 17px; font-weight: 800; margin-bottom: 10px; }
.modal-activities ul { list-style: none; display: grid; gap: 8px; }
.modal-activities li { display: flex; gap: 10px; align-items: flex-start; font-size: 14.5px; color: var(--ink); }
.modal-activities li::before { content: '✦'; color: var(--accent-dark); font-weight: 800; }

.modal-note { margin-top: 18px; font-size: 12.5px; color: var(--muted); background: var(--primary-light); border-radius: var(--radius-sm); padding: 10px 14px; }

/* ============ Responsive ============ */
@media (max-width: 768px) {
  .hero { padding: 60px 0 80px; }
  .search-panel { flex-direction: column; align-items: stretch; }
  .btn-search { justify-content: center; }
  .nav-links { gap: 16px; }
  .modal-grid { grid-template-columns: 1fr; }
  .modal-main { padding: 22px; }
  .section-head { flex-direction: column; align-items: flex-start; }
  .cards-grid { grid-template-columns: 1fr; }
}

@media (max-width: 480px) {
  .brand-name { font-size: 19px; }
  .nav-links a { font-size: 13.5px; }
  .cards-grid { gap: 18px; }
}

/* Reduced motion preference */
@media (prefers-reduced-motion: reduce) {
  * { animation: none !important; transition: none !important; }
  html { scroll-behavior: auto; }
}