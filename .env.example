# Environment variables for Traventure
# Copy this file to backend/.env and fill in your actual values
# NEVER commit the real .env file to Git

# OpenWeather API Key (required for weather data)
# Get your free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Optional: Server port (default: 3000)
# PORT=3000

# Admin authentication (only needed if Admin Panel is enabled)
# ADMIN_EMAIL=your_admin_email
# ADMIN_PASSWORD_HASH=your_bcrypt_hashed_password
# JWT_SECRET=your_jwt_secret_key